# ===== LLM 配置（OpenAI 兼容接口）=====
# 不配置时使用内置演示生成器（基于 RAG + 规则引擎，无需真实 Key 即可跑通流程）
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o-mini

# ===== 数据目录（可选，默认 ./data，运行时自动创建）=====
# DATA_DIR=./data

# ===== 访问令牌（可选；为网页加一层访问门禁）=====
# 留空则本地无门禁（任何人可访问）。
# 设置后，所有页面 / 接口需带 ?token= 才能访问（支持 Cookie / x-access-token / Bearer）。
# APP_ACCESS_TOKEN=

# ===== 知识库 / 系统指令词（可选，默认读取 assets/ 下文件）=====
# KB_JSONL=./assets/kb.jsonl
# SYSTEM_PROMPT_FILE=./assets/system_prompt.md
